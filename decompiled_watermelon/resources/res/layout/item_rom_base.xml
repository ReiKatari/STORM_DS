<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@+id/imageRomIcon" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp"/>
