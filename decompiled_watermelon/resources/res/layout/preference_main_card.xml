<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="@android:color/transparent" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:defaultFocusHighlightEnabled="false">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_watermelon_card_focus" android:paddingTop="14dp" android:paddingBottom="14dp" android:duplicateParentState="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="92dp" android:paddingStart="15dp" android:paddingEnd="12dp">
        <FrameLayout android:background="@drawable/bg_watermelon_icon_tile" android:layout_width="38dp" android:layout_height="38dp">
            <ImageView android:layout_gravity="center" android:id="@android:id/icon" android:layout_width="21dp" android:layout_height="21dp" app:tint="@color/melonMain"/>
        </FrameLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="13dp" android:layout_marginEnd="8dp">
            <TextView android:textSize="14.5sp" android:textColor="@color/textColorPrimary" android:ellipsize="end" android:id="@android:id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:fontFamily="@font/manrope" android:textFontWeight="600"/>
            <TextView android:textSize="11.5sp" android:textColor="@color/textColorSecondary" android:ellipsize="end" android:id="@android:id/summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:fontFamily="@font/manrope"/>
        </LinearLayout>
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron_right_watermelon" app:tint="@color/textColorSecondary"/>
    </LinearLayout>
</FrameLayout>
