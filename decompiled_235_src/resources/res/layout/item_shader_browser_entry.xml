<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_watermelon_dialog_selection" android:paddingTop="6dp" android:paddingBottom="6dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:defaultFocusHighlightEnabled="false">
    <ImageView android:id="@+id/imageShaderEntryIcon" android:layout_width="20dp" android:layout_height="20dp" android:tint="@color/textColorSecondary" android:importantForAccessibility="no" android:layout_marginEnd="14dp"/>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
        <TextView android:textSize="14sp" android:textColor="@color/textColorPrimary" android:ellipsize="middle" android:id="@+id/textShaderEntryName" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:fontFamily="@font/manrope"/>
        <TextView android:textSize="11sp" android:textColor="@color/textColorSecondary" android:id="@+id/textShaderEntryDetail" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:singleLine="true" android:fontFamily="@font/manrope"/>
    </LinearLayout>
    <TextView android:textSize="10sp" android:textColor="@color/colorPrimary" android:id="@+id/textShaderEntryBadge" android:background="@drawable/bg_shader_weight_badge" android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginStart="10dp" android:textFontWeight="700"/>
    <ImageView android:id="@+id/imageShaderEntryChevron" android:visibility="gone" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_right_watermelon" android:importantForAccessibility="no" android:layout_marginStart="8dp"/>
</LinearLayout>
