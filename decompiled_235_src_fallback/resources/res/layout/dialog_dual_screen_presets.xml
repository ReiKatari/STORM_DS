<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:paddingTop="12dp" android:paddingBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp">
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="0dp">
            <LinearLayout android:orientation="vertical" android:padding="14dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" android:textColor="?attr/colorAccent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="@string/dual_screen_info_title"/>
                <TextView android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="?android:attr/textColorSecondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dual_screen_info_desc" android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView android:textAppearance="?android:attr/textAppearanceSmall" android:textStyle="bold" android:textColor="?attr/colorError" android:id="@+id/textPresetsDisabledHint" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/dual_screen_presets_disabled_hint"/>
        <TextView android:textAppearance="?android:attr/textAppearanceSmall" android:textStyle="bold" android:textColor="?attr/colorAccent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/dual_screen_presets" android:textAllCaps="true" android:letterSpacing="0.08"/>
        <RadioGroup android:orientation="vertical" android:id="@+id/radioGroupPresets" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:textAppearance="?android:attr/textAppearanceMedium" android:id="@+id/radioPresetOff" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dual_screen_preset_off"/>
            <RadioButton android:textAppearance="?android:attr/textAppearanceMedium" android:id="@+id/radioPresetInternalTopExternalBottom" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dual_screen_preset_internal_top_external_bottom"/>
            <RadioButton android:textAppearance="?android:attr/textAppearanceMedium" android:id="@+id/radioPresetInternalBottomExternalTop" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dual_screen_preset_internal_bottom_external_top"/>
        </RadioGroup>
        <View android:background="?attr/colorControlHighlight" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
        <androidx.appcompat.widget.SwitchCompat android:textAppearance="?android:attr/textAppearanceMedium" android:id="@+id/switchKeepAspectRatio" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/keep_ds_ratio"/>
        <androidx.appcompat.widget.SwitchCompat android:textAppearance="?android:attr/textAppearanceMedium" android:id="@+id/switchIntegerScale" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dual_screen_integer_scale"/>
        <Button android:id="@+id/buttonFillAreaOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/dual_screen_fill_area_button" style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
        <Button android:id="@+id/buttonVerticalAlignmentOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dual_screen_vertical_alignment_button" style="@style/Widget.AppCompat.Button.Borderless.Colored"/>
        <TextView android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="?android:attr/textColorSecondary" android:id="@+id/textVerticalAlignmentSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:alpha="0.9" android:paddingStart="4dp" android:paddingEnd="4dp"/>
    </LinearLayout>
</ScrollView>
