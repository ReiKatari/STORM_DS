<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/category_translator">
        <SwitchPreferenceCompat android:title="@string/translator_enabled" android:key="translator_enabled" android:summary="@string/translator_enabled_summary" android:defaultValue="false" app:iconSpaceReserved="false"/>
        <ListPreference android:entries="@array/translator_engine_options" android:title="@string/translator_engine" android:key="translator_engine" android:defaultValue="google" android:entryValues="@array/translator_engine_values" app:dependency="translator_enabled" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <ListPreference android:entries="@array/translator_source_lang_options" android:title="@string/translator_source_lang" android:key="translator_source_lang" android:defaultValue="auto" android:entryValues="@array/translator_source_lang_values" app:dependency="translator_enabled" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <ListPreference android:entries="@array/translator_target_lang_options" android:title="@string/translator_target_lang" android:key="translator_target_lang" android:defaultValue="ru" android:entryValues="@array/translator_target_lang_values" app:dependency="translator_enabled" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <ListPreference android:entries="@array/translator_trigger_mode_options" android:title="@string/translator_trigger_mode" android:key="translator_trigger_mode" android:defaultValue="on_demand" android:entryValues="@array/translator_trigger_mode_values" app:dependency="translator_enabled" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <SwitchPreferenceCompat android:title="@string/translator_pause_on_translate" android:key="translator_pause_on_translate" android:summary="@string/translator_pause_on_translate_summary" android:defaultValue="true" app:dependency="translator_enabled" app:iconSpaceReserved="false"/>
        <SwitchPreferenceCompat android:title="@string/translator_show_floating_button" android:key="translator_show_floating_button" android:summary="@string/translator_show_floating_button_summary" android:defaultValue="true" app:dependency="translator_enabled" app:iconSpaceReserved="false"/>
        <Preference android:title="@string/translator_regions_title" android:key="pref_translator_regions" android:summary="@string/translator_edit_regions_hint" app:dependency="translator_enabled" app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_translator_tts">
        <SwitchPreferenceCompat android:title="@string/translator_tts_enabled" android:key="translator_tts_enabled" android:summary="@string/translator_tts_enabled_summary" android:defaultValue="false" app:dependency="translator_enabled" app:iconSpaceReserved="false"/>
        <ListPreference android:entries="@array/translator_tts_voice_engine_options" android:title="Режим озвучки" android:key="translator_tts_voice_engine" android:defaultValue="neural_edge" android:entryValues="@array/translator_tts_voice_engine_values" app:dependency="translator_tts_enabled" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <ListPreference android:entries="@array/translator_tts_lang_options" android:title="@string/translator_tts_lang_title" android:key="translator_tts_lang" android:defaultValue="auto" android:entryValues="@array/translator_tts_lang_values" app:dependency="translator_tts_enabled" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="Локальный AI Voice Actor Studio (Piper TTS)">
        <SwitchPreferenceCompat android:title="AI Voice Actor Studio" android:key="translator_local_voice_actor_studio" android:summary="Автономный оффлайн-синтез голосов персонажей (Piper INT8 ONNX) с динамической сменой тембра, формант и ролей (Герои, Злодеи, Мудрецы, Дети)" android:defaultValue="false" app:iconSpaceReserved="false"/>
        <ListPreference android:entries="@array/translator_local_voice_model_options" android:title="Пакет нейромоделей голоса" android:key="translator_local_voice_model" android:defaultValue="piper_ru_dmitri_medium" android:entryValues="@array/translator_local_voice_model_values" app:dependency="translator_local_voice_actor_studio" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <SeekBarPreference android:max="100" android:title="Вариативность тембра персонажей" android:key="translator_local_voice_pitch_variance" android:defaultValue="65" android:min="0" app:dependency="translator_local_voice_actor_studio" app:iconSpaceReserved="false" app:showSeekBarValue="true"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/translator_overlay_style">
        <ListPreference android:entries="@array/translator_overlay_style_options" android:title="@string/translator_overlay_style" android:key="translator_overlay_style" android:defaultValue="smart_background_match" android:entryValues="@array/translator_overlay_style_values" app:dependency="translator_enabled" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <SeekBarPreference android:max="100" android:title="@string/translator_bubble_opacity" android:key="translator_bubble_opacity" android:defaultValue="90" android:min="10" app:dependency="translator_enabled" app:iconSpaceReserved="false" app:showSeekBarValue="true"/>
        <SeekBarPreference android:max="160" android:title="@string/translator_font_size_scale" android:key="translator_font_size_scale" android:defaultValue="100" android:min="60" app:dependency="translator_enabled" app:iconSpaceReserved="false" app:showSeekBarValue="true"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/translator_api_keys_category" android:key="pref_category_api_keys">
        <EditTextPreference android:title="@string/translator_deepl_key" android:key="translator_deepl_key" android:summary="DeepL Free / Pro API key" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <EditTextPreference android:title="@string/translator_custom_ai_key" android:key="translator_custom_ai_key" android:summary="API Key (OpenAI / Gemini / Claude)" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <EditTextPreference android:title="@string/translator_custom_ai_endpoint" android:key="translator_custom_ai_endpoint" android:defaultValue="https://api.openai.com/v1/chat/completions" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
        <EditTextPreference android:title="@string/translator_custom_ai_model" android:key="translator_custom_ai_model" android:defaultValue="gpt-4o-mini" app:iconSpaceReserved="false" app:useSimpleSummaryProvider="true"/>
    </PreferenceCategory>
</PreferenceScreen>
