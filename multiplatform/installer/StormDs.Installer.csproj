<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StormInstaller</AssemblyName>
    <AssemblyTitle>STORM DS</AssemblyTitle>
    <Title>STORM DS</Title>
    <RootNamespace>StormDs.Installer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>8.9.5</Version>
    <AssemblyVersion>8.9.5.0</AssemblyVersion>
    <FileVersion>8.9.5.0</FileVersion>
    <Product>STORM DS</Product>
    <Company>STORM TEAM</Company>
    <Copyright>Copyright © 2026 STORM TEAM. All rights reserved.</Copyright>
    <Description>STORM DS</Description>
    <NoWarn>$(NoWarn);WFO1000;SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\Payload.zip" LogicalName="Payload.zip" Condition="Exists('Payload\Payload.zip')" />
    <EmbeddedResource Include="..\assets\AppIcon.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="..\assets\AppIcon_256.png" LogicalName="app_icon.png" Condition="Exists('..\assets\AppIcon_256.png')" />
    <EmbeddedResource Include="STORM_Certificate.cer" LogicalName="STORM_CERTIFICATE.cer" Condition="Exists('STORM_Certificate.cer')" />
  </ItemGroup>

</Project>
