<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.stormds.emulator"
          android:versionCode="80000"
          android:versionName="8.0.0"
          android:installLocation="auto">

  <!-- Supports old Android 7.0 Nougat (API 24) up to Android 16 (API 36) -->
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <!-- Optional Vulkan 1.0+ & GLES 2.0+ so old devices with Vulkan 1.0/1.1 or GLES-only install cleanly -->
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400000" android:required="false" />
  <uses-feature android:glEsVersion="0x00020000" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />

  <!-- Law 5: Samsung Game Booster & Android Game Mode API integration -->
  <application android:label="STORM DS"
               android:isGame="true"
               android:appCategory="game"
               android:hardwareAccelerated="true"
               android:largeHeap="true"
               android:requestLegacyExternalStorage="true"
               android:supportsRtl="true">
  </application>
</manifest>
