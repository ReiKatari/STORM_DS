                 let old_back = std::mem::replace(
                     &mut back,
-                    OwnedImage::new(&self.vulkan, input.size, input.format.into(), 1)?,
+                    // Not `new`: routing through ImageFormat drops formats it cannot name, so a
+                    // B8G8R8A8_UNORM input silently produced an R8G8B8A8_UNORM history image. The
+                    // copy below is a raw image copy, so the bytes landed with red and blue
+                    // swapped, and the format comparison above never matched again either, which
+                    // reallocated the history image on every single frame.
+                    OwnedImage::new_with_vk_format(&self.vulkan, input.size, input.format, 1)?,
                 );
                 self.residuals[self.common.internal_frame_count % self.residuals.len()]
                     .dispose_owned(old_back);
