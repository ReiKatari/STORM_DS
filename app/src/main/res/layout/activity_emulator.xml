<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layout_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:layoutDescription="@xml/scene_activity_emulator"
        tools:context=".ui.emulator.EmulatorActivity">

    <me.magnum.melonds.ui.emulator.EmulatorSurfaceView
            android:id="@+id/surfaceMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    <androidx.compose.ui.platform.ComposeView
            android:id="@+id/layout_console_skin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.compose.ui.platform.ComposeView
            android:id="@+id/layout_achievement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

    <me.magnum.melonds.ui.emulator.RuntimeLayoutView
            android:id="@+id/view_layout_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <TextView
            android:id="@+id/textFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:alpha="0.80"
            android:background="@drawable/bg_resolution_hud"
            android:textColor="#10B981"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:elevation="100dp"
            android:visibility="gone"
            tools:text="FPS: 60"/>

    <TextView
            android:id="@+id/textResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:alpha="0.80"
            android:background="@drawable/bg_resolution_hud"
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:elevation="100dp"
            android:visibility="gone"
            tools:text="OpenGL | 512x768 (2x)"/>

    <!-- 3D Console Authentic Loading Experience Screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutLoadingDevice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090A0F"
            android:elevation="200dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

        <!-- Top Right Badge Capsule (Vulkan / Resolution / FPS) -->
        <TextView
                android:id="@+id/textLoadingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_console_badge"
                android:fontFamily="monospace"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Vulkan | 768x1152 (3x)" />

        <!-- Top Left Camera / Sensor Cutout -->
        <View
                android:id="@+id/viewCameraSensor"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="18dp"
                android:background="@drawable/bg_console_led"
                android:backgroundTint="#1E293B"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <!-- Center 3D Console & Progress Container -->
        <LinearLayout
                android:id="@+id/layoutConsoleCenterGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <!-- 3D Console Shell -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/viewConsoleChassis"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:background="@drawable/bg_console_chassis">

                <!-- Top Screen Frame -->
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/viewTopScreenBezel"
                        android:layout_width="0dp"
                        android:layout_height="170dp"
                        android:background="@drawable/bg_console_screen_top"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                            android:id="@+id/layoutTopScreenLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                                android:id="@+id/textLoadingStorm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STORM"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:letterSpacing="0.08" />

                        <TextView
                                android:id="@+id/textLoadingConsoleLogo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="DS"
                                android:textColor="#38BDF8"
                                android:textStyle="bold"
                                android:textSize="20sp"
                                android:letterSpacing="0.08" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Hinge Separator Bar -->
                <View
                        android:id="@+id/viewHingeBar"
                        android:layout_width="64dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_console_hinge"
                        app:layout_constraintTop_toBottomOf="@id/viewTopScreenBezel"
                        app:layout_constraintBottom_toTopOf="@id/viewBottomScreenBezel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                <!-- Bottom Screen Frame -->
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/viewBottomScreenBezel"
                        android:layout_width="0dp"
                        android:layout_height="170dp"
                        android:background="@drawable/bg_console_screen_top"
                        app:layout_constraintTop_toBottomOf="@id/viewHingeBar"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                            android:id="@+id/textLoadingSubScreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NINTENDO DS"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:letterSpacing="0.2"
                            android:fontFamily="sans-serif-medium"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- LED Power Glow Indicator -->
                <View
                        android:id="@+id/viewLedPower"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_console_led"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bottom Status Subtext & Shimmer Progress -->
            <TextView
                    android:id="@+id/textLoadingStage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:text="КОМПИЛЯЦИЯ ШЕЙДЕРОВ VULKAN" />

            <ProgressBar
                    android:id="@+id/progressLoadingConsole"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#38BDF8" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Legacy / Compatibility View Bindings -->
    <TextView
            android:id="@+id/textLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
            android:id="@+id/progressLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <TextView
            android:id="@+id/textLoadingDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <RelativeLayout
            android:id="@+id/layout_rewind"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A000"
            android:focusable="false">
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_rewind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent" />

    <me.magnum.melonds.translator.ui.GameTranslationOverlayView
            android:id="@+id/view_translation_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
            android:id="@+id/layout_pause_menu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.motion.widget.MotionLayout>
