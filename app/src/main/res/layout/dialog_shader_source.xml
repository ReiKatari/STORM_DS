<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Option 1: Scan RetroArch -->
    <LinearLayout
        android:id="@+id/btn_source_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_watermelon_setting_row"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_search"
            app:tint="@color/colorPrimary"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_retroarch_shader_source_scan_retroarch"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/video_retroarch_shader_source_scan_retroarch_description"
                android:textColor="@color/textColorSecondary"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Option 2: Download Shaders -->
    <LinearLayout
        android:id="@+id/btn_source_internal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_watermelon_setting_row"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_download"
            app:tint="@color/colorPrimary"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_retroarch_shader_source_internal"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/video_retroarch_shader_source_internal_description"
                android:textColor="@color/textColorSecondary"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Option 3: Custom Folder -->
    <LinearLayout
        android:id="@+id/btn_source_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_watermelon_setting_row"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/colorPrimary"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_retroarch_shader_source_folder"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/video_retroarch_shader_source_folder_description"
                android:textColor="@color/textColorSecondary"
                android:textSize="12.5sp"
                android:fontFamily="@font/manrope" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
