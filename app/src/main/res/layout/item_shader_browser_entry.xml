<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/bg_watermelon_dialog_selection"
    android:focusable="true"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false">

    <ImageView
        android:id="@+id/imageShaderEntryIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:tint="@color/textColorSecondary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textShaderEntryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textSize="14sp"
            android:textColor="@color/textColorPrimary"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/textShaderEntryDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/manrope"
            android:textSize="11sp"
            android:textColor="@color/textColorSecondary"
            android:singleLine="true"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/textShaderEntryBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_shader_weight_badge"
        android:fontFamily="@font/manrope"
        android:textSize="10sp"
        android:textFontWeight="700"
        android:textColor="@color/colorPrimary"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imageShaderEntryChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron_right_watermelon"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>
