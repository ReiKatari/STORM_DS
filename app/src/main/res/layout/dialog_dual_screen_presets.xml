<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- Informational banner -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dual_screen_info_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAccent"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dual_screen_info_desc"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textPresetsDisabledHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dual_screen_presets_disabled_hint"
            android:textSize="11.5sp"
            android:textColor="?attr/colorError"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dual_screen_presets"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textColor="?attr/colorAccent"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioPresetOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/dual_screen_preset_off"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/radioPresetInternalTopExternalBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/dual_screen_preset_internal_top_external_bottom"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/radioPresetInternalBottomExternalTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/dual_screen_preset_internal_bottom_external_top"
                android:textSize="13sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ПАРАМЕТРЫ МАСШТАБИРОВАНИЯ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?attr/colorAccent"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchKeepAspectRatio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/keep_ds_ratio"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchIntegerScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/dual_screen_integer_scale"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonFillAreaOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12.5sp"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:text="@string/dual_screen_fill_area_button" />

        <Button
            android:id="@+id/buttonVerticalAlignmentOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12.5sp"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:text="@string/dual_screen_vertical_alignment_button" />

        <TextView
            android:id="@+id/textVerticalAlignmentSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:alpha="0.9" />
    </LinearLayout>
</ScrollView>
