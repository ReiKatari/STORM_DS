<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/imageStormEmblem"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_watermelon_mark"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/textRomSearchDirectoryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textSize="15sp"
            android:lineHeight="22sp"
            android:fontFamily="@font/manrope"
            android:textColor="?android:textColorSecondary"
            android:text="@string/no_rom_search_directory_specified" />

        <Button
            android:id="@+id/buttonAction"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:fontFamily="@font/space_grotesk"
            android:textStyle="bold"
            style="@style/Widget.AppCompat.Button.Colored"
            android:text="@string/set_rom_directory" />
    </LinearLayout>
</FrameLayout>