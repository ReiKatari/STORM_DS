<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingEnd="?attr/dialogPreferredPadding"
        android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutGridColours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:id="@+id/layoutColourRow0"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@+id/layoutColourRow1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <View
                    android:id="@+id/viewColour00"
                    style="@style/ColourTile"
                    android:backgroundTint="#61829A"
                    android:tag="0" />

            <View
                    android:id="@+id/viewColour01"
                    style="@style/ColourTile"
                    android:backgroundTint="#BA4900"
                    android:tag="1" />

            <View
                    android:id="@+id/viewColour02"
                    style="@style/ColourTile"
                    android:backgroundTint="#FB0018"
                    android:tag="2" />

            <View
                    android:id="@+id/viewColour03"
                    style="@style/ColourTile"
                    android:backgroundTint="#FB8AFB"
                    android:tag="3" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/layoutColourRow1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toTopOf="@+id/layoutColourRow2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutColourRow0">

            <View
                    android:id="@+id/viewColour10"
                    style="@style/ColourTile"
                    android:backgroundTint="#FB9200"
                    android:tag="4" />

            <View
                    android:id="@+id/viewColour11"
                    style="@style/ColourTile"
                    android:backgroundTint="#F3E300"
                    android:tag="5" />

            <View
                    android:id="@+id/viewColour12"
                    style="@style/ColourTile"
                    android:backgroundTint="#AAFB00"
                    android:tag="6" />

            <View
                    android:id="@+id/viewColour13"
                    style="@style/ColourTile"
                    android:backgroundTint="#00FB00"
                    android:tag="7" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/layoutColourRow2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toTopOf="@+id/layoutColourRow3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutColourRow1">

            <View
                    android:id="@+id/viewColour20"
                    style="@style/ColourTile"
                    android:backgroundTint="#00A238"
                    android:tag="8" />

            <View
                    android:id="@+id/viewColour21"
                    style="@style/ColourTile"
                    android:backgroundTint="#49DB8A"
                    android:tag="9" />

            <View
                    android:id="@+id/viewColour22"
                    style="@style/ColourTile"
                    android:backgroundTint="#30BAF3"
                    android:tag="10" />

            <View
                    android:id="@+id/viewColour23"
                    style="@style/ColourTile"
                    android:backgroundTint="#0059F3"
                    android:tag="11" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/layoutColourRow3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toTopOf="@+id/layoutColourRow4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutColourRow2">

            <View
                    android:id="@+id/viewColour30"
                    style="@style/ColourTile"
                    android:backgroundTint="#000092"
                    android:tag="12" />

            <View
                    android:id="@+id/viewColour31"
                    style="@style/ColourTile"
                    android:backgroundTint="#8A00D3"
                    android:tag="13" />

            <View
                    android:id="@+id/viewColour32"
                    style="@style/ColourTile"
                    android:backgroundTint="#D300EB"
                    android:tag="14" />

            <View
                    android:id="@+id/viewColour33"
                    style="@style/ColourTile"
                    android:backgroundTint="#FB0092"
                    android:tag="15" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/layoutColourRow4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toTopOf="@+id/layoutColourRow5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutColourRow3">

            <View
                    android:id="@+id/viewColour40"
                    style="@style/ColourTile"
                    android:backgroundTint="#FFFFFF"
                    android:tag="16" />

            <View
                    android:id="@+id/viewColour41"
                    style="@style/ColourTile"
                    android:backgroundTint="#121418"
                    android:tag="17" />

            <View
                    android:id="@+id/viewColour42"
                    style="@style/ColourTile"
                    android:backgroundTint="#00E5FF"
                    android:tag="18" />

            <View
                    android:id="@+id/viewColour43"
                    style="@style/ColourTile"
                    android:backgroundTint="#FFD700"
                    android:tag="19" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/layoutColourRow5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutColourRow4">

            <View
                    android:id="@+id/viewColour50"
                    style="@style/ColourTile"
                    android:backgroundTint="#E0115F"
                    android:tag="20" />

            <View
                    android:id="@+id/viewColour51"
                    style="@style/ColourTile"
                    android:backgroundTint="#00E676"
                    android:tag="21" />

            <View
                    android:id="@+id/viewColour52"
                    style="@style/ColourTile"
                    android:backgroundTint="#FF6E40"
                    android:tag="22" />

            <View
                    android:id="@+id/viewColour53"
                    style="@style/ColourTile"
                    android:backgroundTint="#651FFF"
                    android:tag="23" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
