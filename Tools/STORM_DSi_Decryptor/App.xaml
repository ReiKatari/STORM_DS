<Application x:Class="StormDsiDecryptor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="StormFontFamily">Inter Variable, Segoe UI, sans-serif</FontFamily>

            <SolidColorBrush x:Key="ThemeBg" Color="#0D0B18" />
            <SolidColorBrush x:Key="ThemeCardBg" Color="#17132B" />
            <SolidColorBrush x:Key="ThemeCardBorder" Color="#408B5CF6" />
            <SolidColorBrush x:Key="ThemeAccent" Color="#8B5CF6" />
            <SolidColorBrush x:Key="ThemeAccentGlow" Color="#508B5CF6" />
            <SolidColorBrush x:Key="ThemeAccentSoft" Color="#208B5CF6" />
            <SolidColorBrush x:Key="ThemeTextPrimary" Color="#F8FAFC" />
            <SolidColorBrush x:Key="ThemeTextSecondary" Color="#C084FC" />
            <SolidColorBrush x:Key="ThemeSuccess" Color="#10B981" />
            <SolidColorBrush x:Key="ThemeWarning" Color="#F59E0B" />

            <!-- Global Neon Solid Square CheckBox Style -->
            <Style x:Key="StormCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{DynamicResource StormFontFamily}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckSquare"
                                        Width="18" Height="18"
                                        CornerRadius="4"
                                        Background="{DynamicResource ThemeCardBg}"
                                        BorderBrush="{DynamicResource ThemeCardBorder}"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1.5" Opacity="0.35" Color="#000000" />
                                    </Border.Effect>
                                    <Border x:Name="InnerFill"
                                            CornerRadius="2"
                                            Margin="2"
                                            Background="Transparent" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckSquare" Property="Background" Value="{DynamicResource ThemeAccent}" />
                                    <Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                    <Setter TargetName="InnerFill" Property="Background" Value="{DynamicResource ThemeAccent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CheckSquare" Property="Opacity" Value="0.4" />
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox" BasedOn="{StaticResource StormCheckBoxStyle}" />

            <!-- 3D Tactile Standard Button Style -->
            <Style x:Key="StormButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{DynamicResource StormFontFamily}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2.5" Opacity="0.4" Color="#000000" />
                                </Border.Effect>
                                <Grid>
                                    <!-- Top Specular Highlight -->
                                    <Border VerticalAlignment="Top" Height="1" CornerRadius="8,8,0,0"
                                            Background="#35FFFFFF" Margin="1,1,1,0" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                    <Setter TargetName="border" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-1.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3D Tactile Hero Action Button -->
            <Style x:Key="StormHeroButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
                <Setter Property="Foreground" Value="#0D0B18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="{DynamicResource StormFontFamily}" />
                <Setter Property="Padding" Value="22,9" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.5" Color="#000000" />
                                </Border.Effect>
                                <Grid>
                                    <!-- Top Specular Highlight -->
                                    <Border VerticalAlignment="Top" Height="1.2" CornerRadius="9,9,0,0"
                                            Background="#60FFFFFF" Margin="2,1,2,0" />
                                    <!-- Bottom Bevel Edge -->
                                    <Border VerticalAlignment="Bottom" Height="2" CornerRadius="0,0,9,9"
                                            Background="#35000000" Margin="2,0,2,1" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-1.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3D Navigation Tab Button (Radio style) -->
            <Style x:Key="StormTabButton" TargetType="RadioButton">
                <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{DynamicResource StormFontFamily}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True"
                                    Margin="0,0,8,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.3" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentSoft}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Themed ScrollBar Styles (Universal Dark Theme Scrollbars) -->
            <Style x:Key="StormScrollBarPageButton" TargetType="{x:Type RepeatButton}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StormScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="ThumbBorder"
                                    Background="#35FFFFFF"
                                    CornerRadius="4"
                                    Margin="2"
                                    SnapsToDevicePixels="True" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccent}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentGlow}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10" HorizontalAlignment="Center">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource StormScrollBarThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                        <Track x:Name="PART_Track" Width="Auto" Height="10" VerticalAlignment="Center">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource StormScrollBarThumb}" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
