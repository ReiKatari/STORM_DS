<Window x:Class="StormDsiDecryptor.DuplicatePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM DSI DECRYPTOR"
        Icon="AppIcon.ico"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource ThemeCardBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="{DynamicResource StormFontFamily}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource ThemeCardBg}"
            BorderBrush="{DynamicResource ThemeAccent}"
            BorderThickness="1.5"
            CornerRadius="12"
            MinWidth="520"
            MaxWidth="600"
            Margin="0">

        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Details Card -->
                <RowDefinition Height="Auto" /> <!-- Question -->
                <RowDefinition Height="Auto" /> <!-- Checkbox -->
                <RowDefinition Height="Auto" /> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app_icon.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="TxtHeaderTitle" Text="Игра уже обрабатывалась" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Click="BtnClose_Click"
                        Width="30" Height="30" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource ThemeTextSecondary}" Cursor="Hand" Focusable="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                     <Setter TargetName="bd" Property="Background" Value="#EF4444" />
                                     <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                     <Setter TargetName="bd" Property="Background" Value="#DC2626" />
                                     <Setter Property="RenderTransform">
                                         <Setter.Value>
                                             <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                         </Setter.Value>
                                     </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M 0.5 0.5 L 9 9 M 9 0.5 L 0.5 9"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Details Card -->
            <Border Grid.Row="1" Background="#0CFFFFFF" BorderBrush="{DynamicResource ThemeCardBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Игра:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,8,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtGameTitle" Text="Title" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Файл:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,8,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFileName" Text="file.nds" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,2" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,8,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPreviousDate" Text="01.01.2026 12:00" Foreground="{DynamicResource ThemeAccent}" FontWeight="Medium" Margin="0,2,0,2" />
                </Grid>
            </Border>

            <!-- Question Text -->
            <TextBlock Grid.Row="2" x:Name="TxtPrompt"
                       Text="Данная игра уже была успешно обработана ранее. Хотите отменить операцию или обработать её заново?"
                       FontSize="13.5" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" />

            <!-- Apply to all checkbox -->
            <CheckBox Grid.Row="3" x:Name="ChkApplyToAll"
                      Content="Применить ко всем повторным играм"
                      FontSize="12.5" Foreground="{DynamicResource ThemeTextSecondary}"
                      Cursor="Hand" Margin="2,0,0,16" />

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,14,0">
                <Button x:Name="BtnSkip" Content="Пропустить" MinWidth="130" Height="36" Margin="0,0,12,0" Padding="18,0"
                        Style="{StaticResource StormButton}" Click="BtnSkip_Click" />
                <Button x:Name="BtnReprocess" Content="Обработать заново" MinWidth="185" Height="36" Padding="20,0"
                        Style="{StaticResource StormHeroButton}" Click="BtnReprocess_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
