<Window x:Class="StormDsiDecryptor.StormMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM DSi Decryptor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource ThemeCardBg}"
            BorderBrush="{DynamicResource ThemeAccent}"
            BorderThickness="1.5"
            CornerRadius="14"
            MinWidth="420"
            MaxWidth="520"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="5" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <Grid Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="AppIcon.ico" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock FontSize="14" VerticalAlignment="Center">
                        <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                        <Run Text=" DSi Decryptor" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" />
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnClose_Click"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#25FF3344" />
                                    <Setter Property="Foreground" Value="#FF4455" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    ✕
                </Button>
            </Grid>

            <!-- Dialog Body -->
            <Grid Grid.Row="1" Margin="4,0,4,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Status Icon Badge -->
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                        Background="{DynamicResource ThemeCardBorder}"
                        BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.4" Color="#000000" />
                    </Border.Effect>
                    <TextBlock x:Name="TxtIcon" Text="✔" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Message Text -->
                <TextBlock Grid.Column="1" x:Name="TxtMessage"
                           Text="Сообщение"
                           FontSize="14" FontWeight="Medium"
                           Foreground="{DynamicResource ThemeTextPrimary}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           LineHeight="22" />
            </Grid>

            <!-- Dialog Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Отмена" Width="100" Height="34" Margin="0,0,10,0"
                        Style="{StaticResource StormButton}" Visibility="Collapsed" Click="BtnCancel_Click" />
                <Button x:Name="BtnOk" Content="OK" Width="110" Height="34"
                        Style="{StaticResource StormHeroButton}" Click="BtnOk_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
