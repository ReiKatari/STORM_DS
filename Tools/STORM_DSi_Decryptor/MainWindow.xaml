<Window x:Class="StormDsiDecryptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM DSi Decryptor"
        Height="720" Width="1040"
        MinHeight="580" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        Icon="AppIcon.ico"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <!-- 3D Card Style -->
        <Style x:Key="StormCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Standard Button Style -->
        <Style x:Key="StormButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2.5" Opacity="0.4" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Hero Action Button -->
        <Style x:Key="StormHeroButton" TargetType="Button" BasedOn="{StaticResource StormButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="Foreground" Value="#06070A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.5" Color="#00D2FF" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded RadioButton / CheckBox -->
        <Style x:Key="StormCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Stats Bar -->
            <RowDefinition Height="*" />    <!-- Content (Table & Drop Zone) -->
            <RowDefinition Height="Auto" /> <!-- Progress & Controls -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="AppIcon.ico" Width="36" Height="36" Margin="0,0,12,0" />
                    <TextBlock x:Name="TxtAppTitle" Text="STORM DSi Decryptor" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource ThemeCardBorder}" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TxtSubtitle" Text="Сверхбыстрая утилита расшифровки Modcrypt для Nintendo DSi и DSiWare" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="48,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Theme Selector -->
                <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                    <TextBlock x:Name="LblTheme" Text="Тема" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,2" />
                    <ComboBox x:Name="CmbTheme" Width="140" Height="28" SelectionChanged="CmbTheme_SelectionChanged" />
                </StackPanel>
                <!-- Language Selector -->
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="LblLang" Text="Язык" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,2" />
                    <ComboBox x:Name="CmbLang" Width="110" Height="28" SelectionChanged="CmbLang_SelectionChanged" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Stats Counter Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StormCard}" Padding="16,12" Margin="0,0,8,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="LblTotalGames" Text="Всего игр" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StormCard}" Padding="16,12" Margin="4,0,4,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="LblEncrypted" Text="Требуют расшифровки" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock x:Name="TxtEncryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeWarning}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StormCard}" Padding="16,12" Margin="8,0,0,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="LblDecrypted" Text="Готово к запуску" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock x:Name="TxtDecryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area: Drag & Drop + List -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <!-- Drop Hint Container (visible when list is empty) -->
            <Border x:Name="DropZone" Style="{StaticResource StormCard}" Background="{DynamicResource ThemeCardBg}" BorderThickness="2" Cursor="Hand" MouseDown="DropZone_MouseDown">
                <Grid>
                    <!-- Empty List Hint -->
                    <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock x:Name="TxtDragDropHint" Text="Перетащите сюда файлы .nds, .dsi, .app или папку с играми" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="Либо нажмите здесь для выбора файлов вручную" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Games Table (visible when items present) -->
                    <DataGrid x:Name="GridGames" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="Transparent" AlternatingRowBackground="#08FFFFFF"
                              Foreground="{DynamicResource ThemeTextPrimary}"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#15FFFFFF"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              SelectionMode="Extended" HeadersVisibility="Column" Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColFileName" Header="Имя файла" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn x:Name="ColTitle" Header="Название игры" Binding="{Binding GameTitle}" Width="2*" />
                            <DataGridTextColumn x:Name="ColCode" Header="Код" Binding="{Binding GameCode}" Width="80" />
                            <DataGridTextColumn x:Name="ColSize" Header="Размер" Binding="{Binding FileSizeFormatted}" Width="90" />
                            <DataGridTemplateColumn x:Name="ColStatus" Header="Статус" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress and Actions Bar -->
        <Border Grid.Row="3" Style="{StaticResource StormCard}" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Options Row -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RbCopy" GroupName="DecMode" IsChecked="True" Content="Создавать копию (Decrypted)" Style="{StaticResource StormCheckBox}" Margin="0,0,24,0" />
                    <RadioButton x:Name="RbInPlace" GroupName="DecMode" Content="Перезаписывать оригиналы на месте" Style="{StaticResource StormCheckBox}" />
                </StackPanel>

                <!-- Buttons & Progress Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnAddFiles" Content="Добавить файлы" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFiles_Click" />
                        <Button x:Name="BtnAddFolder" Content="Добавить папку" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFolder_Click" />
                        <Button x:Name="BtnClear" Content="Очистить" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnClear_Click" />
                    </StackPanel>

                    <!-- Progress Bar -->
                    <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <ProgressBar x:Name="ProgBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#1AFFFFFF" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnDecrypt" Content="Расшифровать все" Style="{StaticResource StormHeroButton}" Margin="0,0,8,0" Click="BtnDecrypt_Click" />
                        <Button x:Name="BtnOpenFolder" Content="Открыть папку" Style="{StaticResource StormButton}" Click="BtnOpenFolder_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer / Status Log Bar -->
        <TextBlock Grid.Row="4" x:Name="TxtStatusLog" Text="Готово к работе" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Left" />
    </Grid>
</Window>
