<Window x:Class="StormDsiDecryptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM DSI DECRYPTOR 1.1.9"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="{DynamicResource StormFontFamily}"
        Icon="AppIcon.ico"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 3D Card Style -->
        <Style x:Key="StormCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.4" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vector Icon Geometries for Window Control Buttons -->
        <Geometry x:Key="IconMinimize">M 0 0 L 10 0</Geometry>
        <Geometry x:Key="IconMaximize">M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z</Geometry>
        <Geometry x:Key="IconRestore">M 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5 M 7.5 2.5 L 0.5 2.5 L 0.5 9.5 L 7.5 9.5 Z</Geometry>
        <Geometry x:Key="IconClose">M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5</Geometry>

        <!-- Modern Animated Window Caption Buttons -->
        <Style x:Key="StormWindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentGlow}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button with Crimson Glow -->
        <Style x:Key="StormWindowCloseButton" TargetType="Button" BasedOn="{StaticResource StormWindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Theme-Compliant DataGrid Styles (100% Contrast, Zero Black Text, Visible Vertical Dividers) -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#06FFFFFF" />
            <Setter Property="FontFamily" Value="{DynamicResource StormFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DgrBorder" Background="{TemplateBinding Background}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeCardBorder}" SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Visibility="{TemplateBinding DetailsVisibility}" />
                                <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}" />
                                <Setter TargetName="DgrBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Themed ScrollBar Styles (Universal Dark Theme Scrollbars) -->
        <Style x:Key="StormScrollBarPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StormScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#35FFFFFF"
                                CornerRadius="4"
                                Margin="2"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10" HorizontalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource StormScrollBarThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" Width="Auto" Height="10" VerticalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource StormScrollBarThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource StormScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Theme-Compliant ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource StormFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentGlow}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded RadioButton -->
        <Style x:Key="StormRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Styled ComboBox -->
        <Style x:Key="StormComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="8,4,6,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{DynamicResource ThemeCardBg}"
                                                BorderBrush="{DynamicResource ThemeCardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource ThemeAccent}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource ThemeCardBg}"
                                            BorderBrush="{DynamicResource ThemeAccent}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.6" Color="#000000" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled DataGrid ColumnHeader -->
        <Style x:Key="StormColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0,0,1,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Custom 3D ContextMenu Style -->
        <Style x:Key="StormContextMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="Border"
                                Background="{DynamicResource ThemeCardBg}"
                                BorderBrush="{DynamicResource ThemeAccent}"
                                BorderThickness="1.2"
                                CornerRadius="8"
                                Padding="5,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="4" Opacity="0.6" Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom MenuItem Style -->
        <Style x:Key="StormMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="5"
                                Margin="2,1"
                                Padding="12,0,16,0">
                            <ContentPresenter x:Name="HeaderHost"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Menu Separator Style -->
        <Style x:Key="StormMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource ThemeCardBorder}" HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ThemeBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" /> <!-- Custom Window TitleBar -->
            <RowDefinition Height="*" />  <!-- Main Content Body -->
        </Grid.RowDefinitions>

        <!-- 1. Custom TitleBar -->
        <Grid Grid.Row="0" Background="{DynamicResource ThemeCardBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="app_icon.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock FontSize="13.5" VerticalAlignment="Center">
                    <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                    <Run Text=" DSI DECRYPTOR" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" />
                    <Run Text=" 1.1.9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" />
                </TextBlock>
            </StackPanel>

            <!-- Window Drag Area -->
            <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource StormWindowControlButton}" Click="BtnMinimize_Click" ToolTip="Свернуть в панель задач">
                    <Path Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" SnapsToDevicePixels="True" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="BtnMaximize" Style="{StaticResource StormWindowControlButton}" Click="BtnMaximize_Click" ToolTip="Развернуть на весь экран">
                    <Path x:Name="IconMaximizePath" Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" SnapsToDevicePixels="True" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource StormWindowCloseButton}" Click="BtnClose_Click" ToolTip="Свернуть в системный трей">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Application Body -->
        <Grid Grid.Row="1" Margin="20,14,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Navigation Tabs -->
                <RowDefinition Height="Auto" /> <!-- Stats Bar -->
                <RowDefinition Height="*" />    <!-- Main Content (Queue / History) -->
                <RowDefinition Height="Auto" /> <!-- Progress & Controls -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header: App Title, Badges, Theme, Accent, Font & Lang -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="app_icon.png" Width="40" Height="40" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock FontSize="24" VerticalAlignment="Center">
                            <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                            <Run Text=" DSI DECRYPTOR" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="Сверхбыстрая утилита расшифровки Modcrypt для Nintendo DSi и DSiWare" FontSize="12.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="54,4,0,0" />
                </StackPanel>

                <!-- Selectors: Theme, Accent, Font & Language -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector (11 Languages) -->
                    <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                        <TextBlock x:Name="LblLang" Text="🌐 Язык" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbLang" Style="{StaticResource StormComboBox}" Width="145" Height="30" SelectionChanged="CmbLang_SelectionChanged" />
                    </StackPanel>
                    <!-- Theme Selector (9 Themes) -->
                    <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                        <TextBlock x:Name="LblTheme" Text="🎨 Тема" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbTheme" Style="{StaticResource StormComboBox}" Width="190" Height="30" SelectionChanged="CmbTheme_SelectionChanged" />
                    </StackPanel>
                    <!-- Accent Selector (13 Accents) -->
                    <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                        <TextBlock x:Name="LblAccent" Text="✨ Акцент" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbAccent" Style="{StaticResource StormComboBox}" Width="165" Height="30" SelectionChanged="CmbAccent_SelectionChanged" />
                    </StackPanel>
                    <!-- Font Selector (10 Fonts) -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblFont" Text="🔤 Шрифт" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbFont" Style="{StaticResource StormComboBox}" Width="150" Height="30" SelectionChanged="CmbFont_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Navigation Tabs (Queue / History) -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabBtnQueue" GroupName="NavTabs" IsChecked="True" Style="{StaticResource StormTabButton}" Click="TabBtnQueue_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " />
                            <TextBlock x:Name="TxtTabQueue" Text="Очередь обработки" />
                            <TextBlock x:Name="TxtTabQueueCount" Text=" (0)" Opacity="0.8" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabBtnHistory" GroupName="NavTabs" Style="{StaticResource StormTabButton}" Margin="10,0,0,0" Click="TabBtnHistory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜 " />
                            <TextBlock x:Name="TxtTabHistory" Text="История операций" />
                            <TextBlock x:Name="TxtTabHistoryCount" Text=" (0)" Opacity="0.8" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- Stats Counter Cards -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <!-- Queue Stats Panel -->
                <Grid x:Name="QueueStatsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StormCard}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblTotalGames" Text="🎮 Всего игр" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StormCard}" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblEncrypted" Text="🔐 Требуют расшифровки" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtEncryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeWarning}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StormCard}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblDecrypted" Text="⚡ Готово к запуску" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtDecryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- History Stats Panel -->
                <Grid x:Name="HistoryStatsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StormCard}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblHistTotal" Text="📚 Всего в истории" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtHistTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StormCard}" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblHistSuccess" Text="✅ Успешно расшифровано" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtHistSuccessCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StormCard}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblHistReady" Text="⚡ Готово к запуску" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtHistReadyCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Main Content Area: Queue or History -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <!-- 1. QUEUE VIEW -->
                <Grid x:Name="QueueViewPanel">
                    <Border x:Name="DropZone" Style="{StaticResource StormCard}" Background="{DynamicResource ThemeCardBg}" BorderThickness="1.5" Cursor="Hand" MouseDown="DropZone_MouseDown"
                            AllowDrop="True"
                            PreviewDragEnter="Window_PreviewDragEnter"
                            PreviewDragOver="Window_PreviewDragOver"
                            PreviewDrop="Window_PreviewDrop">
                        <Grid>
                            <!-- Empty List Hint -->
                            <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📂" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock x:Name="TxtDragDropHint" Text="Перетащите сюда файлы .nds, .dsi, .app или папку с играми" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="Либо нажмите здесь для выбора файлов вручную" FontSize="12.5" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Games Table -->
                            <DataGrid x:Name="GridGames" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#08FFFFFF"
                                      HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource StormColumnHeader}"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      VerticalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="True"
                                      RowHeight="36"
                                      Visibility="Collapsed"
                                      PreviewKeyDown="GridGames_PreviewKeyDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource StormContextMenu}">
                                        <MenuItem x:Name="MenuDeleteSelected" Header="🗑️ Удалить выбранное (DEL)" Style="{StaticResource StormMenuItem}" Click="MenuDeleteSelected_Click" />
                                        <Separator Style="{StaticResource StormMenuSeparator}" />
                                        <MenuItem x:Name="MenuClearAll" Header="🧹 Очистить весь список" Style="{StaticResource StormMenuItem}" Click="MenuClearAll_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColFileName" Header="Имя файла" Binding="{Binding FileName}" Width="250">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColTitle" Header="Название игры" Binding="{Binding GameTitle}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColCode" Header="Код" Binding="{Binding GameCode}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas, monospace" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColSize" Header="Размер" Binding="{Binding FileSizeFormatted}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn x:Name="ColStatus" Header="Статус" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeWarning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. HISTORY VIEW -->
                <Grid x:Name="HistoryViewPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource StormCard}" Background="{DynamicResource ThemeCardBg}">
                        <Grid>
                            <StackPanel x:Name="EmptyHistoryHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📜" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock x:Name="TxtHistoryEmpty" Text="История операций пуста" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#08FFFFFF"
                                      HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource StormColumnHeader}"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      VerticalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="True"
                                      RowHeight="36"
                                      PreviewKeyDown="GridHistory_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColHistDate" Header="Дата обработки" Binding="{Binding ProcessedAtFormatted}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistName" Header="Имя файла" Binding="{Binding FileName}" Width="230">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistTitle" Header="Название игры" Binding="{Binding GameTitle}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistCode" Header="Код" Binding="{Binding GameCode}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontFamily" Value="Consolas, monospace" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistSize" Header="Размер" Binding="{Binding FileSizeFormatted}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn x:Name="ColHistStatus" Header="Результат" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemeSuccess}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Progress & Action Controls -->
            <Border Grid.Row="4" Style="{StaticResource StormCard}" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <!-- 1. QUEUE CONTROLS -->
                    <Grid x:Name="QueueActionsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Options and Destination Folder Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Mode CheckBoxes -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkCopy" IsChecked="True" Content="📦 Создавать копию" Margin="0,0,20,0" Click="ChkCopy_Click" />
                                <CheckBox x:Name="ChkInPlace" IsChecked="False" Content="🔄 Перезаписывать оригиналы на месте" Margin="0,0,20,0" Click="ChkInPlace_Click" />
                            </StackPanel>

                            <!-- Output Folder Selection -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="LblOutFolder" Text="Папка сохранения:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <Border x:Name="BorderOutFolder" Grid.Column="1" Height="32"
                                        Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                                        BorderThickness="1.5" CornerRadius="7" Cursor="Hand"
                                        AllowDrop="True"
                                        ToolTip="Перетащите сюда папку для назначения пути сохранения"
                                        DragEnter="BorderOutFolder_DragEnter"
                                        DragOver="BorderOutFolder_DragOver"
                                        DragLeave="BorderOutFolder_DragLeave"
                                        Drop="BorderOutFolder_Drop"
                                        PreviewDragEnter="BorderOutFolder_DragEnter"
                                        PreviewDragOver="BorderOutFolder_DragOver"
                                        PreviewDrop="BorderOutFolder_Drop"
                                        MouseDown="BorderOutFolder_MouseDown">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1.5" Opacity="0.3" Color="#000000" />
                                    </Border.Effect>
                                    <Grid VerticalAlignment="Center" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📁 " FontSize="12" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox x:Name="TxtOutFolder" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                                 IsReadOnly="True" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"
                                                 Text="Выберите папку для сохранения копий..."
                                                 Focusable="False" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <Button x:Name="BtnBrowseOutFolder" Grid.Column="2" Content="📂 Обзор..." Style="{StaticResource StormButton}"
                                        Height="32" Padding="12,0" Margin="6,0,0,0" Click="BtnBrowseOutFolder_Click" />

                                <Button x:Name="BtnResetOutFolder" Grid.Column="3" Content="✕" ToolTip="Сбросить на папку по умолчанию"
                                        Style="{StaticResource StormButton}" Height="32" Width="32" Padding="0" Margin="4,0,0,0" Click="BtnResetOutFolder_Click" />
                            </Grid>
                        </Grid>

                        <!-- Buttons & Progress Row -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnAddFiles" Content="📂 Добавить файлы" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFiles_Click" />
                                <Button x:Name="BtnAddFolder" Content="🗂️ Добавить папку" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFolder_Click" />
                                <Button x:Name="BtnClear" Content="🗑️ Очистить список" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnClear_Click" />
                            </StackPanel>

                            <!-- Progress Bar -->
                            <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <ProgressBar x:Name="ProgBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#1AFFFFFF" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0" />
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnDecrypt" Content="⚡ Расшифровать все" Style="{StaticResource StormHeroButton}" Margin="0,0,8,0" Click="BtnDecrypt_Click" />
                                <Button x:Name="BtnOpenFolder" Content="🚪 Открыть папку" Style="{StaticResource StormButton}" Click="BtnOpenFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 2. HISTORY CONTROLS -->
                    <Grid x:Name="HistoryActionsPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnClearHistory" Content="🗑️ Очистить историю" Style="{StaticResource StormButton}" Margin="0,0,10,0" Click="BtnClearHistory_Click" />
                            <Button x:Name="BtnDeleteHistory" Content="✖ Удалить выбранное" Style="{StaticResource StormButton}" Margin="0,0,10,0" Click="BtnDeleteHistory_Click" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenHistoryFolder" Content="📂 Показать в проводнике" Style="{StaticResource StormHeroButton}" Click="BtnOpenHistoryFolder_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Footer / Status Log Bar -->
            <Grid Grid.Row="5" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatusLog" Text="Готово к работе" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCheckUpdates" Content="🔄 Обновления" Style="{StaticResource StormButton}" Height="26" Padding="10,0" FontSize="11" Margin="0,0,8,0" Click="BtnCheckUpdates_Click" />
                    <Button x:Name="BtnAbout" Content="ℹ️ О программе" Style="{StaticResource StormButton}" Height="26" Padding="10,0" FontSize="11" Click="BtnAbout_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
