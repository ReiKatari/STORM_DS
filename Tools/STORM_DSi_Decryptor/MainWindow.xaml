<Window x:Class="StormDsiDecryptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM DSi Decryptor 1.1.4"
        Height="760" Width="1080"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        Icon="AppIcon.ico"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 3D Card Style -->
        <Style x:Key="StormCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window TitleBar Buttons -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E11D48" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded RadioButton -->
        <Style x:Key="StormRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Styled ComboBox -->
        <Style x:Key="StormComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,4,8,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{DynamicResource ThemeCardBg}"
                                                BorderBrush="{DynamicResource ThemeCardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource ThemeAccent}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource ThemeCardBg}"
                                            BorderBrush="{DynamicResource ThemeAccent}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled DataGrid ColumnHeader -->
        <Style x:Key="StormColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0,0,1,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Custom 3D ContextMenu Style without icon gutter -->
        <Style x:Key="StormContextMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="Border"
                                Background="{DynamicResource ThemeCardBg}"
                                BorderBrush="{DynamicResource ThemeAccent}"
                                BorderThickness="1.2"
                                CornerRadius="8"
                                Padding="5,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="4" Opacity="0.6" Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom MenuItem Style without icon gutter -->
        <Style x:Key="StormMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="5"
                                Margin="2,1"
                                Padding="12,0,16,0">
                            <ContentPresenter x:Name="HeaderHost"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2500D2FF" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Menu Separator Style -->
        <Style x:Key="StormMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource ThemeCardBorder}" HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ThemeBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" /> <!-- Custom Window TitleBar -->
            <RowDefinition Height="*" />  <!-- Main Content Body -->
        </Grid.RowDefinitions>

        <!-- 1. Custom TitleBar -->
        <Grid Grid.Row="0" Background="{DynamicResource ThemeCardBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="AppIcon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock FontSize="13" VerticalAlignment="Center">
                    <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                    <Run Text=" DSi Decryptor" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" />
                </TextBlock>
            </StackPanel>

            <!-- Window Drag Area -->
            <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlButton}" Content="—" Click="BtnMinimize_Click" />
                <Button x:Name="BtnMaximize" Style="{StaticResource WindowControlButton}" Content="□" Click="BtnMaximize_Click" />
                <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- 2. Application Body -->
        <Grid Grid.Row="1" Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Navigation Tabs -->
                <RowDefinition Height="Auto" /> <!-- Stats Bar -->
                <RowDefinition Height="*" />    <!-- Main Content (Queue / History) -->
                <RowDefinition Height="Auto" /> <!-- Progress & Controls -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header: App Title, Badges, Theme & Lang -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="AppIcon.ico" Width="38" Height="38" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock FontSize="24" VerticalAlignment="Center">
                            <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                            <Run Text=" DSi Decryptor" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" />
                        </TextBlock>
                        <Border Background="{DynamicResource ThemeCardBorder}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="1.1.4" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="Сверхбыстрая утилита расшифровки Modcrypt для Nintendo DSi и DSiWare" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="52,4,0,0" />
                </StackPanel>

                <!-- Selectors (Theme & Language) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Theme Selector -->
                    <StackPanel Orientation="Vertical" Margin="0,0,14,0">
                        <TextBlock x:Name="LblTheme" Text="Тема" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbTheme" Style="{StaticResource StormComboBox}" Width="215" Height="32" SelectionChanged="CmbTheme_SelectionChanged" />
                    </StackPanel>
                    <!-- Language Selector -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblLang" Text="Язык" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbLang" Style="{StaticResource StormComboBox}" Width="170" Height="32" SelectionChanged="CmbLang_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Navigation Tabs (Queue / History) -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabBtnQueue" GroupName="NavTabs" IsChecked="True" Style="{StaticResource StormTabButton}" Click="TabBtnQueue_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " />
                            <TextBlock x:Name="TxtTabQueue" Text="Очередь обработки" />
                            <TextBlock x:Name="TxtTabQueueCount" Text=" (0)" Opacity="0.8" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabBtnHistory" GroupName="NavTabs" Style="{StaticResource StormTabButton}" Margin="10,0,0,0" Click="TabBtnHistory_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜 " />
                            <TextBlock x:Name="TxtTabHistory" Text="История операций" />
                            <TextBlock x:Name="TxtTabHistoryCount" Text=" (0)" Opacity="0.8" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>

            <!-- Stats Counter Cards -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <!-- Queue Stats Panel -->
                <Grid x:Name="QueueStatsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StormCard}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblTotalGames" Text="Всего игр" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StormCard}" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblEncrypted" Text="Требуют расшифровки" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtEncryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeWarning}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StormCard}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblDecrypted" Text="Готово к запуску" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtDecryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- History Stats Panel (shown when History tab is active) -->
                <Grid x:Name="HistoryStatsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StormCard}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblHistTotal" Text="Всего в истории" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtHistTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StormCard}" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblHistSuccess" Text="Успешно расшифровано" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtHistSuccessCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StormCard}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="LblHistReady" Text="Готово к запуску" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                            <TextBlock x:Name="TxtHistReadyCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Main Content Area: Queue or History -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <!-- 1. QUEUE VIEW -->
                <Grid x:Name="QueueViewPanel">
                    <Border x:Name="DropZone" Style="{StaticResource StormCard}" Background="{DynamicResource ThemeCardBg}" BorderThickness="2" Cursor="Hand" MouseDown="DropZone_MouseDown"
                            AllowDrop="True"
                            PreviewDragEnter="Window_PreviewDragEnter"
                            PreviewDragOver="Window_PreviewDragOver"
                            PreviewDrop="Window_PreviewDrop">
                        <Grid>
                            <!-- Empty List Hint -->
                            <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock x:Name="TxtDragDropHint" Text="Перетащите сюда файлы .nds, .dsi, .app или папку с играми" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="Либо нажмите здесь для выбора файлов вручную" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Games Table -->
                            <DataGrid x:Name="GridGames" AutoGenerateColumns="False" IsReadOnly="True"
                                      AllowDrop="True"
                                      PreviewDragEnter="Window_PreviewDragEnter"
                                      PreviewDragOver="Window_PreviewDragOver"
                                      PreviewDrop="Window_PreviewDrop"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="#06FFFFFF"
                                      Foreground="{DynamicResource ThemeTextPrimary}"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      VerticalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      ColumnHeaderStyle="{StaticResource StormColumnHeader}"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      SelectionMode="Extended" HeadersVisibility="Column" Visibility="Collapsed"
                                      PreviewKeyDown="GridGames_PreviewKeyDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource StormContextMenu}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource StormMenuItem}" />
                                            <Style TargetType="Separator" BasedOn="{StaticResource StormMenuSeparator}" />
                                        </ContextMenu.Resources>
                                        <MenuItem x:Name="MenuDeleteSelected" Header="Удалить выбранное (DEL)" Click="MenuDeleteSelected_Click" />
                                        <Separator />
                                        <MenuItem x:Name="MenuClearAll" Header="Очистить весь список" Click="MenuClearAll_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColFileName" Header="Имя файла" Binding="{Binding FileName}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColTitle" Header="Название игры" Binding="{Binding GameTitle}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColCode" Header="Код" Binding="{Binding GameCode}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColSize" Header="Размер" Binding="{Binding FileSizeFormatted}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn x:Name="ColStatus" Header="Статус" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. HISTORY VIEW -->
                <Grid x:Name="HistoryViewPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource StormCard}" Background="{DynamicResource ThemeCardBg}" BorderThickness="1">
                        <Grid>
                            <!-- Empty History Hint -->
                            <StackPanel x:Name="EmptyHistoryPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📜" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock x:Name="TxtHistoryEmpty" Text="История операций пуста" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="Расшифрованные игры будут автоматически сохраняться здесь" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- History Table -->
                            <DataGrid x:Name="GridHistory" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="Transparent" AlternatingRowBackground="#06FFFFFF"
                                      Foreground="{DynamicResource ThemeTextPrimary}"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      VerticalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                      ColumnHeaderStyle="{StaticResource StormColumnHeader}"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      SelectionMode="Extended" HeadersVisibility="Column"
                                      PreviewKeyDown="GridHistory_PreviewKeyDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource StormContextMenu}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource StormMenuItem}" />
                                            <Style TargetType="Separator" BasedOn="{StaticResource StormMenuSeparator}" />
                                        </ContextMenu.Resources>
                                        <MenuItem x:Name="MenuHistDelete" Header="Удалить из истории (DEL)" Click="BtnDeleteHistory_Click" />
                                        <MenuItem x:Name="MenuHistOpen" Header="Показать в проводнике" Click="BtnOpenHistoryFolder_Click" />
                                        <Separator />
                                        <MenuItem x:Name="MenuHistClearAll" Header="Очистить всю историю" Click="BtnClearHistory_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColHistFileName" Header="Имя файла" Binding="{Binding FileName}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistTitle" Header="Название игры" Binding="{Binding GameTitle}" Width="2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="10,0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistCode" Header="Код" Binding="{Binding GameCode}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistDate" Header="Дата обработки" Binding="{Binding ProcessedAtFormatted}" Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn x:Name="ColHistSize" Header="Размер" Binding="{Binding FileSizeFormatted}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn x:Name="ColHistStatus" Header="Результат" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThemeSuccess}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Progress & Action Controls -->
            <Border Grid.Row="4" Style="{StaticResource StormCard}" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <!-- 1. QUEUE CONTROLS -->
                    <Grid x:Name="QueueActionsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Options and Destination Folder Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Mode CheckBoxes (Solid Neon Square per Rule 4) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkCopy" IsChecked="True" Content="Создавать копию" Margin="0,0,22,0" Click="ChkCopy_Click" />
                                <CheckBox x:Name="ChkInPlace" IsChecked="False" Content="Перезаписывать оригиналы на месте" Margin="0,0,22,0" Click="ChkInPlace_Click" />
                            </StackPanel>

                            <!-- Output Folder Selection (Active only when ChkCopy is selected) -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="LblOutFolder" Text="Папка сохранения:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <Border x:Name="BorderOutFolder" Grid.Column="1" Height="32"
                                        Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                                        BorderThickness="1.5" CornerRadius="7" Cursor="Hand"
                                        AllowDrop="True"
                                        ToolTip="Перетащите сюда папку для назначения пути сохранения"
                                        DragEnter="BorderOutFolder_DragEnter"
                                        DragOver="BorderOutFolder_DragOver"
                                        DragLeave="BorderOutFolder_DragLeave"
                                        Drop="BorderOutFolder_Drop"
                                        PreviewDragEnter="BorderOutFolder_DragEnter"
                                        PreviewDragOver="BorderOutFolder_DragOver"
                                        PreviewDrop="BorderOutFolder_Drop"
                                        MouseDown="BorderOutFolder_MouseDown">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1.5" Opacity="0.3" Color="#000000" />
                                    </Border.Effect>
                                    <Grid VerticalAlignment="Center" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📁 " FontSize="12" Foreground="{DynamicResource ThemeAccent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox x:Name="TxtOutFolder" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                                 IsReadOnly="True" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"
                                                 Text="Выберите папку для сохранения копий..."
                                                 Focusable="False" IsHitTestVisible="False" />
                                    </Grid>
                                </Border>

                                <Button x:Name="BtnBrowseOutFolder" Grid.Column="2" Content="Обзор..." Style="{StaticResource StormButton}"
                                        Height="32" Padding="12,0" Margin="6,0,0,0" Click="BtnBrowseOutFolder_Click" />

                                <Button x:Name="BtnResetOutFolder" Grid.Column="3" Content="✕" ToolTip="Сбросить на папку по умолчанию"
                                        Style="{StaticResource StormButton}" Height="32" Width="32" Padding="0" Margin="4,0,0,0" Click="BtnResetOutFolder_Click" />
                            </Grid>
                        </Grid>

                        <!-- Buttons & Progress Row -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnAddFiles" Content="Добавить файлы" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFiles_Click" />
                                <Button x:Name="BtnAddFolder" Content="Добавить папку" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFolder_Click" />
                                <Button x:Name="BtnClear" Content="Очистить" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnClear_Click" />
                            </StackPanel>

                            <!-- Progress Bar -->
                            <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <ProgressBar x:Name="ProgBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#1AFFFFFF" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0" />
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnDecrypt" Content="Расшифровать все" Style="{StaticResource StormHeroButton}" Margin="0,0,8,0" Click="BtnDecrypt_Click" />
                                <Button x:Name="BtnOpenFolder" Content="Открыть папку" Style="{StaticResource StormButton}" Click="BtnOpenFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 2. HISTORY CONTROLS -->
                    <Grid x:Name="HistoryActionsPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnClearHistory" Content="Очистить историю" Style="{StaticResource StormButton}" Margin="0,0,10,0" Click="BtnClearHistory_Click" />
                            <Button x:Name="BtnDeleteHistory" Content="Удалить выбранное" Style="{StaticResource StormButton}" Margin="0,0,10,0" Click="BtnDeleteHistory_Click" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnOpenHistoryFolder" Content="Показать в проводнике" Style="{StaticResource StormHeroButton}" Click="BtnOpenHistoryFolder_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Footer / Status Log Bar -->
            <TextBlock Grid.Row="5" x:Name="TxtStatusLog" Text="Готово к работе" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Left" />
        </Grid>
    </Grid>
</Window>
