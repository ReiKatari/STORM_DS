<Window x:Class="StormDsiDecryptor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM DSi Decryptor 1.0.1"
        Height="740" Width="1060"
        MinHeight="600" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        Icon="AppIcon.ico"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 3D Card Style -->
        <Style x:Key="StormCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window TitleBar Buttons -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E11D48" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded RadioButton -->
        <Style x:Key="StormRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Styled ComboBox -->
        <Style x:Key="StormComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,4,8,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{DynamicResource ThemeCardBg}"
                                                BorderBrush="{DynamicResource ThemeCardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource ThemeAccent}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource ThemeCardBg}"
                                            BorderBrush="{DynamicResource ThemeAccent}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Circular" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styled DataGrid ColumnHeader -->
        <Style x:Key="StormColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0,0,1,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource ThemeBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" /> <!-- Custom Window TitleBar -->
            <RowDefinition Height="*" />  <!-- Main Content Body -->
        </Grid.RowDefinitions>

        <!-- 1. Custom TitleBar -->
        <Grid Grid.Row="0" Background="{DynamicResource ThemeCardBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="AppIcon.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock FontSize="13" VerticalAlignment="Center">
                    <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                    <Run Text=" DSi Decryptor" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" />
                </TextBlock>
            </StackPanel>

            <!-- Window Drag Area -->
            <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

            <!-- Window Control Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlButton}" Content="—" Click="BtnMinimize_Click" />
                <Button x:Name="BtnMaximize" Style="{StaticResource WindowControlButton}" Content="□" Click="BtnMaximize_Click" />
                <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>

        <!-- 2. Application Body -->
        <Grid Grid.Row="1" Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Stats Bar -->
                <RowDefinition Height="*" />    <!-- Content (Table & Drop Zone) -->
                <RowDefinition Height="Auto" /> <!-- Progress & Controls -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header: App Title, Badges, Theme & Lang -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="AppIcon.ico" Width="38" Height="38" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock FontSize="24" VerticalAlignment="Center">
                            <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                            <Run Text=" DSi Decryptor" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" />
                        </TextBlock>
                        <Border Background="{DynamicResource ThemeCardBorder}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="1.0.1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtSubtitle" Text="Сверхбыстрая утилита расшифровки Modcrypt для Nintendo DSi и DSiWare" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="52,4,0,0" />
                </StackPanel>

                <!-- Selectors (Theme & Language) - Equal Width 165px -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Theme Selector -->
                    <StackPanel Orientation="Vertical" Margin="0,0,14,0">
                        <TextBlock x:Name="LblTheme" Text="Тема" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbTheme" Style="{StaticResource StormComboBox}" Width="165" Height="32" SelectionChanged="CmbTheme_SelectionChanged" />
                    </StackPanel>
                    <!-- Language Selector -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblLang" Text="Язык" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbLang" Style="{StaticResource StormComboBox}" Width="165" Height="32" SelectionChanged="CmbLang_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Stats Counter Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StormCard}" Padding="16,12" Margin="0,0,8,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblTotalGames" Text="Всего игр" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StormCard}" Padding="16,12" Margin="4,0,4,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblEncrypted" Text="Требуют расшифровки" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock x:Name="TxtEncryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeWarning}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StormCard}" Padding="16,12" Margin="8,0,0,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="LblDecrypted" Text="Готово к запуску" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                        <TextBlock x:Name="TxtDecryptedCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Content Area: Drag & Drop + List -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <!-- Drop Hint Container (visible when list is empty) -->
                <Border x:Name="DropZone" Style="{StaticResource StormCard}" Background="{DynamicResource ThemeCardBg}" BorderThickness="2" Cursor="Hand" MouseDown="DropZone_MouseDown">
                    <Grid>
                        <!-- Empty List Hint -->
                        <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📂" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock x:Name="TxtDragDropHint" Text="Перетащите сюда файлы .nds, .dsi, .app или папку с играми" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Либо нажмите здесь для выбора файлов вручную" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Games Table (visible when items present) - Full styling with visible dividers and centered headers -->
                        <DataGrid x:Name="GridGames" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent" AlternatingRowBackground="#06FFFFFF"
                                  Foreground="{DynamicResource ThemeTextPrimary}"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                  VerticalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                                  ColumnHeaderStyle="{StaticResource StormColumnHeader}"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  SelectionMode="Extended" HeadersVisibility="Column" Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColFileName" Header="Имя файла" Binding="{Binding FileName}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="10,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="ColTitle" Header="Название игры" Binding="{Binding GameTitle}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="10,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="ColCode" Header="Код" Binding="{Binding GameCode}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn x:Name="ColSize" Header="Размер" Binding="{Binding FileSizeFormatted}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn x:Name="ColStatus" Header="Статус" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Progress and Actions Bar -->
            <Border Grid.Row="3" Style="{StaticResource StormCard}" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Options Row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbCopy" GroupName="DecMode" IsChecked="True" Content="Создавать копию (Decrypted)" Style="{StaticResource StormRadioButton}" Margin="0,0,24,0" />
                        <RadioButton x:Name="RbInPlace" GroupName="DecMode" Content="Перезаписывать оригиналы на месте" Style="{StaticResource StormRadioButton}" />
                    </StackPanel>

                    <!-- Buttons & Progress Row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="BtnAddFiles" Content="Добавить файлы" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFiles_Click" />
                            <Button x:Name="BtnAddFolder" Content="Добавить папку" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnAddFolder_Click" />
                            <Button x:Name="BtnClear" Content="Очистить" Style="{StaticResource StormButton}" Margin="0,0,8,0" Click="BtnClear_Click" />
                        </StackPanel>

                        <!-- Progress Bar -->
                        <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="ProgBar" Height="14" Minimum="0" Maximum="100" Value="0" Background="#1AFFFFFF" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnDecrypt" Content="Расшифровать все" Style="{StaticResource StormHeroButton}" Margin="0,0,8,0" Click="BtnDecrypt_Click" />
                            <Button x:Name="BtnOpenFolder" Content="Открыть папку" Style="{StaticResource StormButton}" Click="BtnOpenFolder_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Footer / Status Log Bar -->
            <TextBlock Grid.Row="4" x:Name="TxtStatusLog" Text="Готово к работе" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Left" />
        </Grid>
    </Grid>
</Window>
