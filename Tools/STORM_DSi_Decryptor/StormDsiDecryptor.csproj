<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <AssemblyName>STORM DSI DECRYPTOR</AssemblyName>
    <RootNamespace>StormDsiDecryptor</RootNamespace>
    <Version>1.1.9</Version>
    <AssemblyVersion>1.1.9.0</AssemblyVersion>
    <FileVersion>1.1.9.0</FileVersion>
    <Authors>STORM TEAM</Authors>
    <Company>STORM SOFT</Company>
    <Product>STORM DSI DECRYPTOR</Product>
    <Title>STORM DSI DECRYPTOR 1.1.9</Title>
    <Description>Сверхбыстрая утилита расшифровки Modcrypt для Nintendo DSi и DSiWare</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Installer\**" />
    <None Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.7" />
  </ItemGroup>

</Project>
